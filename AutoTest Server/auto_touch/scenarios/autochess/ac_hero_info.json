{
  "note": "Clicking an owned unit (a 3D object, reached through the PhysicsRaycaster) toggles its info panel.",
  "tags": ["ui", "input"],
  "setup": [{"action": "include", "scenario": "_fresh_match.json", "params": {"seed": 61}}],
  "actions": [
    {"action": "click", "target": "unit:1", "label": "click the unit"},
    {"action": "wait_state", "path": "views.ui.heroInfo", "equals": 1, "timeoutMs": 2000},
    {"action": "assert_ui", "path": "ArenaUIManager/HeroInfo", "expect": {"active": true}},
    {"action": "screenshot"},
    {"action": "click", "target": "unit:1", "label": "click again closes it"},
    {"action": "wait_state", "path": "views.ui.heroInfo", "equals": -1, "timeoutMs": 2000}
  ]
}
