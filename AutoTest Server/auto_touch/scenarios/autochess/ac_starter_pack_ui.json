{
  "note": "Starter pack through the real UI: reroll an offer, select one, confirm. The chosen hero lands on the bench, its component on the item bench, the HUD and the item bench open and the shop is rolled.",
  "tags": ["ui", "starter"],
  "actions": [
    {"action": "op", "op": "restart", "params": {"seed": 3}},
    {"action": "wait_state", "path": "views.ui.starterPack", "equals": true, "timeoutMs": 5000},
    {"action": "state", "path": "player.starterOffers.2", "saveAs": "before"},
    {"action": "click", "path": "ArenaUIManager/StarterPack/offers/StarterPack_Offer_2/refresh", "label": "reroll offer 2"},
    {"action": "assert", "path": "player.starterOffers.2", "notEquals": "${before}", "label": "offer 2 changed"},
    {"action": "state", "path": "player.starterOffers.1", "saveAs": "picked"},
    {"action": "click", "target": "starter:1", "label": "select offer 1"},
    {"action": "click", "path": "ArenaUIManager/StarterPack/confirm", "label": "confirm"},
    {"action": "wait_state", "path": "phase", "equals": "Preparation", "timeoutMs": 5000},
    {"action": "assert", "path": "player.units.0.unit", "equals": "${picked.unit}", "label": "chosen hero owned"},
    {"action": "assert", "path": "player.units.0.location", "equals": "bench:0"},
    {"action": "assert", "path": "player.items.0.id", "equals": "${picked.item}", "label": "chosen item owned"},
    {"action": "assert", "path": "views.ui.starterPack", "equals": false},
    {"action": "assert", "path": "views.ui.arena", "equals": true},
    {"action": "assert", "path": "views.ui.inventory", "equals": true, "label": "the new item opened the item bench"},
    {"action": "assert", "path": "player.shop.slots", "length": 5},
    {"action": "assert", "path": "views.roster", "equals": 1, "label": "one roster view"},
    {"action": "invariants", "minSeverity": "medium"},
    {"action": "screenshot"}
  ]
}
